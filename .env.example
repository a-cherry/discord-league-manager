DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_STAFF_CHANNEL_ID=
DISCORD_STAFF_ROLE_IDS=
DISCORD_TRANSFER_ANNOUNCEMENTS_CHANNEL_ID=
DISCORD_MATCH_RESULTS_ANNOUNCEMENTS_CHANNEL_ID=

GOOGLE_SERVICE_ACCOUNT_KEY_B64=
GOOGLE_LEAGUE_DB_ID=

# Optional: warn makes the match sequence rules (second loss, repeats) warnings
# GGB_SEQUENCE_RULES=warn

# The read-only PokeTracker API (docs/pktr-api.md). Unset, it's off.
# API_ENABLED=true
# Comma-separated label:sha256hex pairs: the SHA-256 of each issued key, never the key.
# API_KEYS=
# The same, for /trainers/by-discord only.
# API_LOOKUP_KEYS=
# HMAC key for opaque trainer ids. Never rotate it.
# API_ID_SECRET=
# jsDelivr base, up to and including /assets/logos
# API_LOGO_BASE_URL=
